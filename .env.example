# Copy to .env.local and fill in for a real deployment.
# The app runs fully without these — forms fall back to local queueing
# and the payment step runs in mock mode.

# Backend endpoint that forwards Feedback/Contact form submissions to the
# founder's inbox (Section 7 of the spec). POST { kind, submittedAt, payload }.
VITE_MAIL_API_URL=

# 'mock' (default) or 'live'. This beta ships only the mock payment path;
# 'live' is a placeholder for wiring a real gateway (see paymentService.ts).
VITE_PAYMENT_MODE=mock

# Public site origin used to build the QR code's donor-facing receipt URL.
# Defaults to window.location.origin if unset.
VITE_SITE_URL=
